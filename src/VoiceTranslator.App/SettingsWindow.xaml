<Window x:Class="VoiceTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · VoxMate" Icon="Assets/voxmate.ico" Width="650" Height="730" MinWidth="590" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F8FAFF" FontFamily="Microsoft YaHei UI" Foreground="#101936">
    <Grid Margin="14" Background="#F8FAFF">
        <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#DEE3EF" BorderThickness="1" CornerRadius="9,0,0,9" Padding="8">
            <StackPanel>
                <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Margin="8,3,0,13"/>
                <Button x:Name="BasicNav" Style="{StaticResource FlatButton}" Content="⚙  基础设置" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="BasicNav_Click"/>
                <Button x:Name="SpeechNav" Style="{StaticResource FlatButton}" Content="♩  语音识别" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="SpeechNav_Click"/>
                <Button x:Name="TranslationNav" Style="{StaticResource FlatButton}" Content="✧  翻译设置" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="TranslationNav_Click"/>
                <TextBlock Text="快捷键" Foreground="#A0A8BC" Margin="14,8,0,0"/>
                <TextBlock Text="外观设置" Foreground="#A0A8BC" Margin="14,16,0,0"/>
                <Button Style="{StaticResource FlatButton}" Content="◷  历史记录" HorizontalContentAlignment="Left" Margin="0,8,0,5" Click="HistoryNav_Click"/>
                <TextBlock Text="关于" Foreground="#A0A8BC" Margin="14,16,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="#DEE3EF" BorderThickness="0,1,1,1" CornerRadius="0,9,9,0" Padding="17,15">
            <Grid>
                <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="基础设置" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Separator/>
                    <CheckBox Content="开机启动（后续版本）" IsEnabled="False" Margin="3,12,0,9"/>
                    <CheckBox Content="关闭主窗口时最小化到托盘" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <CheckBox Content="始终置顶" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <TextBlock Text="显示模式" FontSize="12" Margin="3,6,0,6"/>
                    <ComboBox x:Name="DisplayModeCombo" SelectedIndex="0" Height="30">
                        <ComboBoxItem Content="标准模式"/>
                        <ComboBoxItem Content="迷你模式（悬浮小窗）"/>
                    </ComboBox>
                    <TextBlock Text="界面语言" FontSize="12" Margin="3,17,0,6"/>
                    <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="简体中文"/></ComboBox>
                    <CheckBox Content="识别后自动翻译" IsChecked="{Binding AutoTranslate, Mode=TwoWay}" Margin="3,15,0,9"/>
                    <CheckBox Content="自动复制译文" IsChecked="{Binding AutoCopyTranslation, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <CheckBox Content="自动粘贴（实验功能，默认关闭）" IsEnabled="False" Margin="3,0,0,9"/>
                    <TextBlock Text="粘贴延迟（毫秒）" FontSize="12" Margin="3,5,0,6"/>
                    <TextBox Text="300" IsEnabled="False" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                    <CheckBox Content="保存历史记录（默认关闭，存储在本机）" IsChecked="{Binding SaveHistory, Mode=TwoWay}" Margin="3,15,0,9"/>
                  </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TranslationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="翻译设置" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Separator/>
                        <TextBlock Text="翻译引擎" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="本地模型（离线，免费）"/></ComboBox>
                        <TextBlock Text="本地模型" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="Qwen2.5 0.5B Q4_K_M（轻量 CPU）"/></ComboBox>
                        <TextBlock Text="目标语言" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeLanguages}" Height="30"/>
                        <TextBlock Text="翻译模式" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox x:Name="TranslationModeCombo" Height="30" SelectionChanged="TranslationModeCombo_SelectionChanged">
                            <ComboBoxItem Content="直接翻译" Tag="Direct"/>
                            <ComboBoxItem Content="AI Prompt" Tag="AiPrompt"/>
                            <ComboBoxItem Content="技术开发" Tag="Technical"/>
                            <ComboBoxItem Content="学术翻译" Tag="Academic"/>
                            <ComboBoxItem Content="商务翻译" Tag="Business"/>
                            <ComboBoxItem Content="自定义模式（当前按直接翻译）" Tag="Custom"/>
                        </ComboBox>
                        <TextBlock Text="llama-cli.exe" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LlamaExecutablePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="浏览..." Margin="7,0,0,0" Click="BrowseLlamaExecutable_Click"/>
                        </Grid>
                        <TextBlock Text="GGUF 模型文件" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LlamaModelPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="浏览..." Margin="7,0,0,0" Click="BrowseLlamaModel_Click"/>
                        </Grid>
                        <Button Style="{StaticResource FlatButton}" Content="打开模型目录" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenModelsFolder_Click"/>
                        <TextBlock Text="API 设置（可选）" FontSize="13" FontWeight="SemiBold" Margin="3,17,0,8"/>
                        <WrapPanel IsEnabled="False">
                            <Button Content="OpenAI" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="DeepL" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="Gemini" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="自定义" Padding="9,4"/>
                        </WrapPanel>
                        <TextBlock Text="API Key" FontSize="12" Margin="3,12,0,5"/>
                        <TextBox Text="在线 API 尚未接入" IsEnabled="False" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="模型" FontSize="12" Margin="3,12,0,5"/>
                        <Grid IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="93"/></Grid.ColumnDefinitions>
                            <ComboBox Height="30" SelectedIndex="0"><ComboBoxItem Content="选择在线模型"/></ComboBox>
                            <Button Grid.Column="1" Content="测试连接" Margin="7,0,0,0"/>
                        </Grid>
                        <TextBlock Text="在线 API 功能尚未接入；离线翻译不会发送文字。" Foreground="#7B849A" FontSize="11" TextWrapping="Wrap" Margin="3,8,0,4"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SpeechPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="语音识别设置" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Separator/>
                        <TextBlock Text="识别引擎" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="whisper.cpp（本地，免费）"/></ComboBox>
                        <TextBlock Text="识别语言" FontSize="12" Margin="3,13,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedSourceLanguage, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeLanguages}" Height="30"/>
                        <TextBlock Text="麦克风设备" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Height="30"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="刷新" Margin="7,0,0,0" Click="RefreshDevices_Click"/>
                        </Grid>
                        <TextBlock Text="whisper-cli.exe" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WhisperExecutablePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="浏览..." Margin="7,0,0,0" Click="BrowseExecutable_Click"/>
                        </Grid>
                        <TextBlock Text="多语言模型（ggml-base.bin / ggml-small.bin）" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WhisperModelPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="浏览..." Margin="7,0,0,0" Click="BrowseModel_Click"/>
                        </Grid>
                        <Button Style="{StaticResource FlatButton}" Content="打开模型目录" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenModelsFolder_Click"/>
                        <CheckBox Content="自动检测语音结束（后续版本）" IsEnabled="False" Margin="3,12,0,4"/>
                        <CheckBox Content="使用 GPU（当前 CPU 构建不可用）" IsEnabled="False" Margin="3,4,0,4"/>
                        <TextBlock Text="录音输出为 16 kHz、单声道、16-bit PCM WAV；识别结束后立即清理临时音频。" TextWrapping="Wrap" Foreground="#7B849A" FontSize="11" Margin="3,18,0,6"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
