<Window x:Class="VoiceTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VoiceTranslator.App"
        Title="{loc:Tr Key='Settings · VoxMate'}" Icon="Assets/voxmate.ico" Width="710" Height="730" MinWidth="650" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F8FAFF" FontFamily="Segoe UI" Foreground="#101936">
    <Grid Margin="14" Background="#F8FAFF">
        <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#DEE3EF" BorderThickness="1" CornerRadius="9,0,0,9" Padding="8">
            <StackPanel>
                <TextBlock Text="{loc:Tr Key='Settings'}" FontSize="18" FontWeight="Bold" Margin="8,3,0,13"/>
                <Button x:Name="BasicNav" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='⚙  Basic settings'}" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="BasicNav_Click"/>
                <Button x:Name="SpeechNav" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='♩  Speech recognition'}" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="SpeechNav_Click"/>
                <Button x:Name="TranslationNav" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='✧  Translation settings'}" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="TranslationNav_Click"/>
                <TextBlock Text="{loc:Tr Key='Shortcuts'}" Foreground="#A0A8BC" Margin="14,8,0,0"/>
                <TextBlock Text="{loc:Tr Key='Appearance'}" Foreground="#A0A8BC" Margin="14,16,0,0"/>
                <Button Style="{StaticResource FlatButton}" Content="{loc:Tr Key='◷  History'}" HorizontalContentAlignment="Left" Margin="0,8,0,5" Click="HistoryNav_Click"/>
                <TextBlock Text="{loc:Tr Key='About'}" Foreground="#A0A8BC" Margin="14,16,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="#DEE3EF" BorderThickness="0,1,1,1" CornerRadius="0,9,9,0" Padding="17,15">
            <Grid>
                <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="{loc:Tr Key='Basic settings'}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Separator/>
                    <CheckBox Content="{loc:Tr Key='Launch at startup (coming later)'}" IsEnabled="False" Margin="3,12,0,9"/>
                    <CheckBox Content="{loc:Tr Key='Minimize to tray when closing the main window'}" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <CheckBox Content="{loc:Tr Key='Always on top'}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <TextBlock Text="{loc:Tr Key='Display mode'}" FontSize="12" Margin="3,6,0,6"/>
                    <ComboBox x:Name="DisplayModeCombo" SelectedIndex="0" Height="30">
                        <ComboBoxItem Content="{loc:Tr Key='Standard mode'}"/>
                        <ComboBoxItem Content="{loc:Tr Key='Mini floating window'}"/>
                    </ComboBox>
                    <TextBlock Text="{loc:Tr Key='Interface language'}" FontSize="12" Margin="3,17,0,6"/>
                    <ComboBox SelectedIndex="0" Height="30" IsEnabled="False"><ComboBoxItem Content="{loc:CurrentLanguage}"/></ComboBox>
                    <CheckBox Content="{loc:Tr Key='Translate automatically after recognition'}" IsChecked="{Binding AutoTranslate, Mode=TwoWay}" Margin="3,15,0,9"/>
                    <CheckBox Content="{loc:Tr Key='Copy translations automatically'}" IsChecked="{Binding AutoCopyTranslation, Mode=TwoWay}" Margin="3,0,0,9"/>
                    <CheckBox Content="{loc:Tr Key='Automatic pasting (currently unavailable)'}" IsEnabled="False" Margin="3,0,0,9"/>
                    <TextBlock Text="{loc:Tr Key='Paste delay (ms)'}" FontSize="12" Margin="3,5,0,6"/>
                    <TextBox Text="300" IsEnabled="False" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                    <CheckBox Content="{loc:Tr Key='Save history (off by default; stored locally)'}" IsChecked="{Binding SaveHistory, Mode=TwoWay}" Margin="3,15,0,9"/>
                  </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TranslationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key='Translation settings'}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Separator/>
                        <TextBlock Text="{loc:Tr Key='Translation engine'}" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="{loc:Tr Key='Local model (offline, free)'}"/></ComboBox>
                        <TextBlock Text="{loc:Tr Key='Local model'}" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="{loc:Tr Key='Qwen2.5 0.5B Q4_K_M (lightweight CPU)'}"/></ComboBox>
                        <TextBlock Text="{loc:Tr Key='Target language'}" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeLanguages}" Height="30"/>
                        <TextBlock Text="{loc:Tr Key='Translation mode'}" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox x:Name="TranslationModeCombo" Height="30" SelectionChanged="TranslationModeCombo_SelectionChanged">
                            <ComboBoxItem Content="{loc:Tr Key='Direct translation'}" Tag="Direct"/>
                            <ComboBoxItem Content="AI Prompt" Tag="AiPrompt"/>
                            <ComboBoxItem Content="{loc:Tr Key='Technical'}" Tag="Technical"/>
                            <ComboBoxItem Content="{loc:Tr Key='Academic'}" Tag="Academic"/>
                            <ComboBoxItem Content="{loc:Tr Key='Business'}" Tag="Business"/>
                            <ComboBoxItem Content="{loc:Tr Key='Custom (currently uses Direct)'}" Tag="Custom"/>
                        </ComboBox>
                        <TextBlock Text="llama-cli.exe" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LlamaExecutablePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Browse...'}" Margin="7,0,0,0" Click="BrowseLlamaExecutable_Click"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr Key='GGUF model file'}" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LlamaModelPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Browse...'}" Margin="7,0,0,0" Click="BrowseLlamaModel_Click"/>
                        </Grid>
                        <Button Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Open model folder'}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenModelsFolder_Click"/>
                        <TextBlock Text="{loc:Tr Key='API settings (optional)'}" FontSize="13" FontWeight="SemiBold" Margin="3,17,0,8"/>
                        <WrapPanel IsEnabled="False">
                            <Button Content="OpenAI" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="DeepL" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="Gemini" Margin="0,0,6,0" Padding="9,4"/>
                            <Button Content="{loc:Tr Key='Custom'}" Padding="9,4"/>
                        </WrapPanel>
                        <TextBlock Text="API Key" FontSize="12" Margin="3,12,0,5"/>
                        <TextBox Text="{loc:Tr Key='Online API is not configured'}" IsEnabled="False" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="{loc:Tr Key='Model'}" FontSize="12" Margin="3,12,0,5"/>
                        <Grid IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <ComboBox Height="30" SelectedIndex="0"><ComboBoxItem Content="{loc:Tr Key='Select online model'}"/></ComboBox>
                            <Button Grid.Column="1" Content="{loc:Tr Key='Test connection'}" Margin="7,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr Key='Online API is not configured; offline translation does not send text.'}" Foreground="#7B849A" FontSize="11" TextWrapping="Wrap" Margin="3,8,0,4"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SpeechPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key='Speech recognition settings'}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Separator/>
                        <TextBlock Text="{loc:Tr Key='Recognition engine'}" FontSize="12" Margin="3,12,0,5"/>
                        <ComboBox SelectedIndex="0" Height="30"><ComboBoxItem Content="{loc:Tr Key='whisper.cpp (local, free)'}"/></ComboBox>
                        <TextBlock Text="{loc:Tr Key='Recognition language'}" FontSize="12" Margin="3,13,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedSourceLanguage, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChangeLanguages}" Height="30"/>
                        <TextBlock Text="{loc:Tr Key='Microphone device'}" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Height="30"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Refresh'}" Margin="7,0,0,0" Click="RefreshDevices_Click"/>
                        </Grid>
                        <TextBlock Text="whisper-cli.exe" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WhisperExecutablePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Browse...'}" Margin="7,0,0,0" Click="BrowseExecutable_Click"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr Key='Multilingual model (ggml-base.bin / ggml-small.bin)'}" FontSize="12" Margin="3,13,0,5"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WhisperModelPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Browse...'}" Margin="7,0,0,0" Click="BrowseModel_Click"/>
                        </Grid>
                        <Button Style="{StaticResource FlatButton}" Content="{loc:Tr Key='Open model folder'}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenModelsFolder_Click"/>
                        <CheckBox Content="{loc:Tr Key='Automatic end-of-speech detection (coming later)'}" IsEnabled="False" Margin="3,12,0,4"/>
                        <CheckBox Content="{loc:Tr Key='Use GPU (unavailable in this CPU build)'}" IsEnabled="False" Margin="3,4,0,4"/>
                        <TextBlock Text="{loc:Tr Key='Recordings are 16 kHz mono 16-bit PCM WAV; temporary audio is removed after recognition.'}" TextWrapping="Wrap" Foreground="#7B849A" FontSize="11" Margin="3,18,0,6"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
