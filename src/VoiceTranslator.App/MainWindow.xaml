<Window x:Class="VoiceTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:VoiceTranslator.Core;assembly=VoiceTranslator.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VoxMate" Icon="Assets/voxmate.ico" Width="500" Height="555" MinWidth="470" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize" Background="#F7F9FF"
        FontFamily="Microsoft YaHei UI" Foreground="#101936">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Background="#F7F9FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="59"/>
            <RowDefinition Height="125"/>
            <RowDefinition Height="135"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7F8FF" BorderBrush="#E3E7F3" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/voxmate-icon.png" Width="23" Height="23" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="VoxMate" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,13,0"/>
                <Border Grid.Column="2" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#584BFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Recording}"><Setter Property="Background" Value="#F04450"/></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.SourceReady}"><Setter Property="Background" Value="#10A96B"/></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Completed}"><Setter Property="Background" Value="#10A96B"/></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Error}"><Setter Property="Background" Value="#D05542"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{Binding PinButtonTooltip}" Click="PinButton_Click">
                    <TextBlock Text="&#xE718;">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource IconText}"><Setter Property="Foreground" Value="#9AA4BB"/><Style.Triggers><DataTrigger Binding="{Binding AlwaysOnTop}" Value="True"><Setter Property="Foreground" Value="#584BFF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="最小化" Click="MinimizeButton_Click">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE921;" FontSize="12"/>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource FlatButton}" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="最大化或还原" Click="MaximizeButton_Click">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE922;" FontSize="12"/>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource FlatButton}" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="关闭" Click="CloseButton_Click">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedSourceLanguage, Mode=TwoWay}" IsEnabled="{Binding CanChangeLanguages}" ToolTip="识别语言" FontSize="12" VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding FlagUri}" Width="20" Height="14" Stretch="Fill" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="⇄" FontSize="20" Padding="0" BorderThickness="0" Background="Transparent" Command="{Binding SwapLanguagesCommand}" ToolTip="交换识别与翻译语言"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}" IsEnabled="{Binding CanChangeLanguages}" ToolTip="翻译目标语言" FontSize="12" VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding FlagUri}" Width="20" Height="14" Stretch="Fill" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="3" Style="{StaticResource FlatButton}" Margin="7,0,0,0" Padding="0" Content="清空" FontSize="11" Command="{Binding ClearCommand}" ToolTip="清空当前文本"/>
            <Button Grid.Column="4" Style="{StaticResource FlatButton}" Margin="7,0,0,0" Padding="0" ToolTip="设置" Click="SettingsButton_Click">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Width="92" Height="92" CornerRadius="46" Background="#DDE2FF" HorizontalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="38" Background="#B7C0FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleRecordingCommand}" Width="64" Height="64" BorderThickness="0" Cursor="Hand" ToolTip="开始或停止录音">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#5162F9"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="32">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Background" Value="#F04450"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE720;" FontSize="31" Foreground="White"/>
                    </Button>
                </Border>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding RecordingButtonText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="3" Margin="10,2,10,6" Background="White" BorderBrush="#DCE2F0" BorderThickness="1" CornerRadius="10">
            <Grid Margin="14,10">
                <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="{Binding SourceResultHeader}" FontSize="12" Foreground="#58627C"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatButton}" Content="复制" FontSize="10" Padding="7,2" Margin="0,0,5,0" Command="{Binding CopySourceCommand}"/>
                        <Button Style="{StaticResource FlatButton}" Content="粘贴" FontSize="10" Padding="7,2" Command="{Binding PasteSourceCommand}"/>
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#111B3E"/>
                <TextBlock Grid.Row="2" Text="{Binding SourceCount, StringFormat={}{0}/5000}" FontSize="10" Foreground="#697590" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="10,0,10,8" Background="White" BorderBrush="#DCE2F0" BorderThickness="1" CornerRadius="10">
            <Grid Margin="14,10">
                <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="{Binding TranslationResultHeader}" FontSize="12" Foreground="#58627C" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Content="翻译" FontSize="10" Padding="7,2" Margin="0,0,5,0" Command="{Binding TranslateCommand}"/>
                    <Button Style="{StaticResource FlatButton}" Content="复制" FontSize="10" Padding="7,2" Margin="0,0,5,0" Command="{Binding CopyTranslationCommand}"/>
                    <Button x:Name="TranslationModeButton" Style="{StaticResource FlatButton}" Padding="8,3" BorderThickness="0" Background="#F0F1FF" Click="TranslationModeButton_Click">
                        <TextBlock Text="{Binding TranslationModeLabel, StringFormat={}{0}  ▾}" FontSize="10" Foreground="#584BFF"/>
                    </Button>
                    </StackPanel>
                    <Popup x:Name="TranslationModePopup" PlacementTarget="{Binding ElementName=TranslationModeButton}" Placement="Bottom" HorizontalOffset="-190" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="285" Background="White" BorderBrush="#CBD3E7" BorderThickness="1" CornerRadius="10" Padding="5">
                            <Border.Effect><DropShadowEffect Color="#1D2B52" BlurRadius="15" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="翻译模式" FontSize="11" Foreground="#6F7891" Margin="9,5,0,6"/>
                                <Separator/>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Background="#EDF0FF" Padding="9,6" HorizontalContentAlignment="Left" Tag="Direct" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="直接翻译  ✓" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="按当前语言方向翻译，简洁准确" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Padding="9,6" HorizontalContentAlignment="Left" Tag="AiPrompt" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="AI Prompt（推荐）" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="整理为适合 AI 助手的目标语言提示词" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Padding="9,6" HorizontalContentAlignment="Left" Tag="Technical" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="技术开发" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="保留代码符号和技术含义" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Padding="9,6" HorizontalContentAlignment="Left" Tag="Academic" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="学术翻译" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="适合论文与学术写作" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Padding="9,6" HorizontalContentAlignment="Left" Tag="Business" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="商务翻译" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="适合商务与正式场景" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" BorderThickness="0" Padding="9,6" HorizontalContentAlignment="Left" Tag="Custom" Click="ModeOption_Click">
                                    <StackPanel><TextBlock Text="自定义模式" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="预留自定义提示词配置" Foreground="#8A94A9" FontSize="10"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding TranslationText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#111B3E"/>
                <TextBlock Grid.Row="2" Text="{Binding TranslationCount, StringFormat={}{0}/5000}" FontSize="10" Foreground="#697590" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="1" Background="#FFF1F0" BorderBrush="#F5C5C2" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15,0,15,2" Padding="8,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="10" Foreground="#A33D36" MaxWidth="460"/>
        </Border>
        <Border Grid.Row="4" Background="#EDF9F2" BorderBrush="#A9DEBE" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" Padding="10,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasSuccess}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding SuccessText}" FontSize="11" Foreground="#08794A" TextWrapping="Wrap" MaxWidth="380"/>
        </Border>
    </Grid>
</Window>
